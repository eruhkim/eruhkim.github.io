---
import type { Post } from '../lib/posts';
import { postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{posts.length === 0 ? (
	<p class="empty">아직 글이 없습니다.</p>
) : (
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<FormattedDate date={post.data.pubDate} />
				<div>
					<a href={postUrl(post)}>{post.data.title}</a>
					{post.data.draft && <span class="draft">초안</span>}
					<p>{post.data.description}</p>
				</div>
			</li>
		))}
	</ul>
)}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	time {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		font-size: 0.9rem;
		padding-top: 0.15rem;
	}
	a {
		font-weight: 600;
		color: var(--fg);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	p {
		margin: 0.2rem 0 0;
		color: var(--muted);
		font-size: 0.925rem;
	}
	.draft {
		margin-left: 0.4rem;
		font-size: 0.75rem;
		padding: 0.05rem 0.4rem;
		border-radius: 4px;
		background: var(--warn-bg);
		color: var(--warn-fg);
	}
	.empty {
		color: var(--muted);
	}
	@media (max-width: 560px) {
		.post-list li {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
