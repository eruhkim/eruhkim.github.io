---
import type { Post } from '../lib/posts';
import { postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{posts.length === 0 ? (
	<p class="empty">아직 글이 없습니다.</p>
) : (
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<span class="when"><FormattedDate date={post.data.pubDate} /></span>
				<a class="title" href={postUrl(post)}>{post.data.title}</a>
				{post.data.draft && <span class="draft">초안</span>}
				<p>{post.data.description}</p>
			</li>
		))}
	</ul>
)}

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		position: relative;
		margin: 0 0 26px;
		padding-left: var(--date-col);
	}
	.when {
		position: absolute;
		left: 0;
		top: 0.15em;
		width: calc(var(--date-col) - 1rem);
		color: var(--accent);
		font-size: 13.5px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.005em;
		white-space: nowrap;
	}
	.title {
		color: var(--ink);
		font-weight: 600;
		font-size: 16px;
	}
	.title:hover {
		color: var(--accent);
		text-decoration: none;
	}
	p {
		max-width: 70ch;
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 14.5px;
		line-height: 1.7;
	}
	.draft {
		margin-left: 6px;
		padding: 1px 6px;
		border-radius: 4px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 11.5px;
		font-weight: 600;
		vertical-align: 2px;
	}
	.empty {
		color: var(--muted);
	}
	@media (max-width: 640px) {
		li {
			padding-left: 0;
			margin-bottom: 22px;
		}
		.when {
			position: static;
			display: block;
			width: auto;
			margin-bottom: 1px;
			font-size: 12.5px;
		}
	}
</style>
