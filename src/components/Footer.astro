</footer>

<style>
	footer {
		max-width: 880px;
		margin: 40px auto 0;
		padding: 28px 32px 48px;
		border-top: 1px solid var(--line);
		color: var(--faint);
		font-size: 12.5px;
		text-align: center;
	}
	a {
		color: inherit;
	}
	a:hover {
		color: var(--muted);
	}
</style>
