---
import Base from '../../layouts/Base.astro';
import { getPosts, tagUrl } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
---

<Base title="태그" description="태그별 글 목록">
	<h1>태그</h1>
	{tags.length === 0 ? <p>아직 태그가 없습니다.</p> : (
		<ul>
			{tags.map(([tag, n]) => (
				<li><a href={tagUrl(tag)}>#{tag}</a> <span>{n}</span></li>
			))}
		</ul>
	)}
</Base>

<style>
	h1 {
		font-size: 1.5rem;
		margin: 0 0 1.5rem;
	}
	ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.25rem;
	}
	a {
		color: var(--fg);
		text-decoration: none;
		font-weight: 600;
	}
	a:hover {
		color: var(--accent);
	}
	span {
		color: var(--muted);
		font-size: 0.85rem;
	}
</style>
