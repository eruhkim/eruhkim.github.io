---
import PostList from '../components/PostList.astro';
import TagList from '../components/TagList.astro';
import { SITE_BYLINE, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>{SITE_NAME}</h1>
	<p class="byline">{SITE_BYLINE}</p>
	<p class="lead">{SITE_DESCRIPTION} <a href="/about/">블로그 소개 →</a></p>
	<h2 class="section">글</h2>
	<PostList posts={posts} />
	<h2 class="section">태그</h2>
	<TagList posts={posts} />
</Base>

<style>
	h1 {
		margin-bottom: 6px;
	}
	.byline {
		margin: 0;
		color: var(--muted);
		font-size: 19px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.lead a {
		white-space: nowrap;
		font-size: 14.5px;
	}
</style>
