---
import FormattedDate from '../components/FormattedDate.astro';
import type { Post } from '../lib/posts';
import { tagUrl } from '../lib/posts';
import Base from './Base.astro';

type Props = Post['data'];
const { title, description, pubDate, updatedDate, tags, draft } = Astro.props;
---

<Base title={title} description={description} type="article">
	<article>
		<header class="post-head">
			<p class="meta">
				<FormattedDate date={pubDate} />
				{updatedDate && <span class="updated">수정 <FormattedDate date={updatedDate} /></span>}
				{draft && <span class="draft">초안</span>}
			</p>
			<h1>{title}</h1>
			{tags.length > 0 && (
				<p class="tags">
					{tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
				</p>
			)}
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
	<p class="back"><a href="/">← 글 목록</a></p>
</Base>

<style>
	.post-head {
		margin-bottom: 44px;
		padding-bottom: 28px;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		font-size: 34px;
		line-height: 1.3;
		letter-spacing: -0.03em;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin: 0 0 12px;
		color: var(--accent);
		font-size: 13.5px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.updated {
		color: var(--muted);
		font-weight: 400;
	}
	.draft {
		padding: 1px 6px;
		border-radius: 4px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 11.5px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: 14px 0 0;
		font-size: 13.5px;
	}
	.tags a {
		color: var(--muted);
	}
	.tags a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.back {
		margin: 56px 0 0;
		font-size: 14px;
	}
	.back a {
		color: var(--muted);
	}
	@media (max-width: 640px) {
		h1 {
			font-size: 26px;
		}
	}
</style>
